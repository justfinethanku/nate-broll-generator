# B-Roll Pipeline Environment Variables
# Copy this to ~/.claude/.env and fill in your values

# AssemblyAI API Key (for transcription)
# Get yours at: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_key_here

# Path to the cloned nate-broll-generator repo
# Set automatically by setup.sh
BROLL_HOME=/path/to/nate-broll-generator
